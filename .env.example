# ── Local Ollama backend (default) ───────────────────────────────────────────
# Ollama must be running: https://ollama.ai
# Pull the enabled models listed in agents.yaml.
OLLAMA_BASE_URL=http://localhost:11434

# ── Runtime behavior ──────────────────────────────────────────────────────────
# semantic | keyword | off. Semantic mode needs requirements-semantic.txt;
# without it, routing falls back to handcrafted episodic retrieval.
MAHORAGA_MEMORY_MODE=semantic

# Generated Python is executed locally for code/test/refactor/debug validation.
# Set to off only when you understand the reduced reward quality.
MAHORAGA_EXEC_GATE=on

# Optional worker directory and MCP backend override.
# MAHORAGA_WORKDIR=/absolute/path/to/project
MAHORAGA_BASE=http://localhost:8000

# ── Optional: cloud and CLI adapters ──────────────────────────────────────────
# An API key does not enable an adapter whose agents.yaml section is disabled.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AIDER_MODEL=

# ── Optional: Telegram channel ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Optional: Web search tool ─────────────────────────────────────────────────
BRAVE_API_KEY=
