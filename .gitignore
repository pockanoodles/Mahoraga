.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.db
.env
.worktrees/
.aider.*
# experiments/ is scratch: local prompt banks, model outputs, working runs.
# Published evidence is opted in explicitly below — a file becomes committable
# when it backs a claim in experiments/claims.json, and `orch bench verify`
# fails if a claimed artifact is missing. Use `experiments/*` rather than
# `experiments/`: git will not descend into an excluded directory, so a bare
# directory rule makes the negations below silently inert.
experiments/*
*.jsonl
!tests/orchestrator_v2/fixtures/*.jsonl
!experiments/claims.json
!experiments/build_humaneval_bank.py
!experiments/prompts_humaneval_plus.jsonl
!experiments/prompts_humaneval_plus_refs.jsonl
!experiments/live_route_humaneval_164.jsonl
!experiments/repro_2026-08-04.jsonl
!experiments/build_humaneval_variants.py
!experiments/humaneval_variants.jsonl
# NOTE: experiments/prompts_humaneval_variants.jsonl (the built probe bank) still
# needs its own negation line when the specs reach full size. It is generated, so
# it stays out of the tree while the spec file is a seed.
.claude/

# Local AI-call context / build scaffolding — never pushed
docs/superpowers/
.DS_Store

# Runtime state — the router's decision data lives in ~/.mahoraga-v2/, not the repo
brain/decisions/log.md

# Demo source footage — large, regenerable, and not part of the product.
demo/raw/

# Rendered film — 26MB, regenerable with demo/assemble.sh
demo/out/
