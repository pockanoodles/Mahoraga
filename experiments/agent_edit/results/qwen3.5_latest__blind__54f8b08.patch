+    """Extract code from a model response, handling fenced blocks.
+    
+    Handles both complete and truncated (unclosed) fenced code blocks.
+    For unclosed/truncated fences, strips the fence markers and returns
+    just the code content to ensure it's runnable.
+    """
+    # Pattern to match fenced code blocks (opening fence + content + optional closing fence)
+    pattern = r'```(?:\w+)?\n(.*?)```'
+    
+    # Try to find a complete fenced block first
+    match = re.search(pattern, response, re.DOTALL)
+    
+    if match:
+        # Extract just the code content (without fences)
+        return match.group(1).strip()
+    
+    # No complete fenced block found - check for unclosed fence
+    # If there's an opening fence but no closing, strip it and return raw content
+    unclosed_pattern = r'```(?:\w+)?\n(.*)'
+    unclosed_match = re.search(unclosed_pattern, response, re.DOTALL)
+    
+    if unclosed_match:
+        # Return just the code content without the opening fence
+        return unclosed_match.group(1).strip()
+    
+    # No fence at all - return raw response
+    return response.strip()
 
 
