-
-    while lines and _SIGNOFF_RE.match(lines[-1].strip()):
-        lines.pop()
-
-    return "\n".join(lines).strip()
+    """Remove conversational preamble and signoff from a model response.
+    
+    Extracts just the core content by removing leading conversational text
+    and trailing sign-off phrases.
+    """
+    # Split on newlines and find the first non-conversational line
+    lines = response.split('\n')
+    
+    for i, line in enumerate(lines):
