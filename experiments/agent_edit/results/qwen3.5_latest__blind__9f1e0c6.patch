+    for key, value in sorted(env.items()):
+        if key != "PATH":
+            print(f"{key}={value}")
+    print("============================\n")
+    
+    # Render full plist
+    content = _PLIST_TEMPLATE.format(
+        label=_LABEL,
+        orch_bin="/usr/local/bin/mahoraga-orchestrator",
+        workdir=str(Path.home()),
+        log=Path.home() / "Library/Logs/Mahoraga/orchestrator.log",
+        env_entries=env_entries,
+    )
+    
+    # Write plist to temp location for inspection
+    plist_path = Path.home() / "Library/LaunchAgents/com.mahoraga.v2.orchestrator.plist"
