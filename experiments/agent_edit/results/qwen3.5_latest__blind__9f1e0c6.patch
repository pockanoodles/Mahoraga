+def _render_env_entries(env: dict[str, str]) -> str:
+    """Render environment variables as plist XML.
+    
+    Escapes special characters (&, <, >) for XML safety.
+    """
+    entries = []
+    
+    for key, value in sorted(env.items()):
+        # Escape XML special characters
+        escaped_value = (value.replace("&", "&amp;")
+                        .replace("<", "&lt;")
+                        .replace(">", "&gt;"))
+        
+        entries.append(f'        <key>{key}</key>')
+        entries.append(f'        <string>{escaped_value}</string>')
+    
+    return "\n".join(entries)
 
