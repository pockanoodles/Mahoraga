+
+def _parse_env_file(path: Path) -> dict[str, str]:
+    """Parse KEY=VALUE lines from an env file.
+    
+    Ignores comments (lines starting with #), blank lines, and malformed lines.
+    Strips surrounding quotes from values.
+    """
+    result: dict[str, str] = {}
+    
+    if not path.exists():
+        return result
+    
+    for line in path.read_text().splitlines():
+        line = line.strip()
+        
+        # Skip empty lines and comments
+        if not line or line.startswith("#"):
+            continue
+        
+        # Skip lines without equals sign
+        if "=" not in line:
+            continue
+        
+        key, _, value = line.partition("=")
+        key = key.strip()
+        value = value.strip()
+        
+        # Skip if key is empty
+        if not key:
+            continue
+        
+        # Strip surrounding quotes from value
+        if len(value) >= 2 and (value[0] == '"' and value[-1] == '"' or 
+                                value[0] == "'" and value[-1] == "'"):
+            value = value[1:-1]
+        
+        result[key] = value
+    
+    return result
+
+
+# ── environment building ─────────────────────────────────────────────────────
+
+
+def _build_environment() -> dict[str, str]:
+    """Build the environment dictionary for the daemon.
+    
+    Includes:
+    - PATH covering ~/.local/bin, venv, Homebrew, and system paths
+    - Any KEY=VALUE from ~/.mahoraga-v2/service.env
+    - HOME set to user's home directory
+    """
+    env = {"HOME": str(Path.home())}
+    
+    # Build PATH with all required entries
+    path_entries = _DEFAULT_PATH.split(":")
+    
+    # Override with custom PATH if specified in service.env
+    custom_env = _parse_env_file(_SERVICE_ENV_FILE)
+    if "PATH" in custom_env:
+        env["PATH"] = custom_env["PATH"]
+    else:
+        env["PATH"] = _DEFAULT_PATH
+    
+    # Add all other env vars from service.env
+    for key, value in custom_env.items():
+        if key != "PATH":  # PATH already handled above
+            env[key] = value
+    
+    return env
 
