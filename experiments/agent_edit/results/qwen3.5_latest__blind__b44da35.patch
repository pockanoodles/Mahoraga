+def compute_funnel(log_path: Path | None = None, since: str | None = None) -> FunnelResult:
+    """Compute funnel metrics from a log file.
+
+    Liveness rows (empty session) are filtered by the window but do not 
+    affect counters or rates — only interpretation.
+    """
+    if log_path is None:
+        log_path = DEFAULT_LOG
+    
+    rows: list[dict] = []
+    last_alive_ts: datetime | None = None
+    
+    try:
+        with log_path.open() as fh:
+            for line in fh:
+                line = line.strip()
+                if not line:
+                    continue
+                
+                try:
+                    row = json.loads(line)
+                except json.JSONDecodeError:
+                    continue
+                
+                # Apply window filter to liveness too
+                if since:
+                    row_ts = datetime.fromisoformat(row["ts"].replace("Z", "+00:00"))
+                    since_dt = datetime.fromisoformat(since.replace("Z", "+00:00"))
+                    if row_ts < since_dt:
+                        continue
+                
+                rows.append(row)
+                
+                # Track most recent alive observation
+                if row["event"] == ALIVE_EVENT:
+                    last_alive_ts = datetime.fromisoformat(row["ts"].replace("Z", "+00:00"))
+    except Exception:
+        pass
+    
+    # Separate inline and delegated events
+    delegations = [r for r in rows if r.get("event") == "delegated"]
+    candidates = [r for r in rows if r.get("candidate", False)]
+    inline_total = len([r for r in rows if r.get("event") == "inline"])
+    
+    # Count sessions (only non-empty session)
+    sessions = len(set(r["session"] for r in rows if r.get("session")))
+    
+    # Liveness rows have empty session, so they don't count toward sessions
+    
+    # Compute metrics
+    delegated_count = len(delegations)
+    candidate_count = len(candidates)
+    
+    # Delegation rate is only meaningful when we have candidates
+    if candidate_count > 0:
+        delegation_rate = delegated_count / candidate_count
+    else:
+        delegation_rate = None
+    
+    # Determine interpretation
+    mcp_alive = last_alive_ts is not None
+    has_delegable_work = candidate_count > 0
+    
+    if not has_delegable_work:
+        interpretation = "no-delegable-work"
+    elif not mcp_alive:
+        interpretation = "tool-liveness-unknown"
+    elif delegated_count == 0:
+        interpretation = "tool-available-unused"
+    else:
+        interpretation = "measured"
+    
+    return FunnelResult(
+        delegated=delegated_count,
+        candidates=candidate_count,
+        inline_total=inline_total,
+        delegable=candidate_count,
+        delegation_rate=delegation_rate,
+        sessions=sessions,
+        mcp_alive=mcp_alive,
+        mcp_alive_observations=sum(1 for r in rows if r["event"] == ALIVE_EVENT),
+        last_alive_ts=last_alive_ts.isoformat() if last_alive_ts else None,
+        interpretation=interpretation,
+    )
 
