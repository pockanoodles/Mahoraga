+"""Record liveness probes for Mahoraga's MCP server.
+
+This runs on the tool-discovery path and records when `run_task` becomes
+visible to agents. A rate without liveness evidence is uninterpretable — 
+it cannot tell the difference between "never delegated" and "tool never started".
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+ALIVE_EVENT = "mcp-alive"
+LOG_PATH = Path.home() / ".mahoraga-v2" / "funnel.jsonl"
+
+
+def record_alive(tools: int, log_path: Path) -> None:
+    """Record that the MCP server is alive with N tools.
+
+    This is fire-and-forget and must never raise on unwritable paths or 
+    missing directories — a liveness probe that can break tool discovery 
+    is worse than no liveness probe.
+    """
+    if os.getenv("MAHORAGA_FUNNEL_LIVENESS", "on") == "off":
+        return
+    
+    try:
+        log_path.parent.mkdir(parents=True, exist_ok=True)
+        row = {
+            "ts": None,  # Will be set by caller or left empty
+            "session": "",  # Must not create a phantom session
+            "event": ALIVE_EVENT,
+            "tools": tools,
+        }
+        with log_path.open("a") as fh:
+            fh.write(json.dumps(row) + "\n")
+    except Exception:  # noqa: BLE001 — must never raise
+        pass
