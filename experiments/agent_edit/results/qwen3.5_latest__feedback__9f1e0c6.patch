+def _parse_env_file(path: Path) -> dict[str, str]:
+    """Parse KEY=VALUE lines from a service.env file."""
+    env = {}
+    if not path.exists():
+        return env
+
+    for line in path.read_text().splitlines():
+        line = line.strip()
+        # Skip empty lines and comments
+        if not line or line.startswith("#"):
+            continue
+        # Skip lines without an equals sign
+        if "=" not in line:
+            continue
+        key, _, value = line.partition("=")
+        key = key.strip()
+        # Skip lines with empty keys (e.g., "=novalue")
+        if not key:
+            continue
+        value = value.strip()
+        # Strip surrounding quotes if present
+        if (value.startswith('"') and value.endswith('"')) or \
+           (value.startswith("'") and value.endswith("'")):
+            value = value[1:-1]
+        env[key] = value
+
+    return env
+
+
+def _build_environment() -> dict[str, str]:
+    """Build the environment dict for the launchd job."""
+    # Start with defaults
+    env: dict[str, str] = {
+        "PATH": os.environ.get("PATH", "/usr/bin:/bin:/usr/sbin:/sbin"),
+        "HOME": str(Path.home()),
+    }
+
+    # Parse service.env if it exists
+    parsed_env = _parse_env_file(_SERVICE_ENV_FILE)
+    env.update(parsed_env)
+
+    # Build PATH: respect user's choice, but ensure required dirs are present
+    path_entries = []
+    for entry in env["PATH"].split(":"):
+        path_entries.append(entry)
+
+    # Add ~/.local/bin (where `claude` CLI lives) — only if not already present
+    local_bin = Path.home() / ".local" / "bin"
+    if str(local_bin) not in path_entries:
+        path_entries.insert(0, str(local_bin))
+
+    # Add venv bin — only if not already present
+    venv_bin = _PROJECT_ROOT / ".venv" / "bin"
+    if str(venv_bin) not in path_entries:
+        path_entries.insert(0, str(venv_bin))
+
+    # Add Homebrew bin — only if not already present
+    homebrew_bin = "/opt/homebrew/bin"
+    if homebrew_bin not in path_entries:
+        path_entries.insert(0, homebrew_bin)
+
+    env["PATH"] = ":".join(path_entries)
+
+    return env
+
+
+def _render_env_entries(env: dict[str, str]) -> str:
+    """Render environment variables as XML plist entries."""
+    lines = []
+    for key, value in sorted(env.items()):
+        # Escape XML special characters
+        escaped_value = value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+        lines.append(f'        <key>{key}</key>')
+        lines.append(f'        <string>{escaped_value}</string>')
+
+    return "\n".join(lines)
+
+
+def _load_job() -> tuple[bool, str]:
+    """Load the launchd job, handling disabled state and error messages."""
+    # Check if disabled in launchd's database
+    result = subprocess.run(
+        ["launchctl", "isenabled", _LABEL],
+        capture_output=True,
+        text=True,
+        check=False
+    )
+    if result.returncode == 0 and result.stdout.strip() == "false":
+        # Label is disabled — enable it first
+        enable_result = subprocess.run(
+            ["launchctl", "enable", _LABEL],
+            capture_output=True,
+            text=True,
+            check=False
+        )
+
+    # Load the job
+    load_result = subprocess.run(
+        ["launchctl", "load", str(_PLIST_PATH)],
+        capture_output=True,
+        text=True,
+        check=False
+    )
+
+    # Verify via `list` since `load` can exit 0 even on failure
+    list_result = _launchctl("list", _LABEL)
+    if list_result.returncode != 0:
+        return False, f"Service not running: {list_result.stderr.strip() or 'Load failed'}"
+
+    # Check for "Input/output error" in load output
+    if "Input/output error" in load_result.stdout:
+        return False, f"Load failed: {load_result.stdout.strip()}"
+
+    return True, ""
+
+
 def _launchctl(*args: str) -> subprocess.CompletedProcess[str]:
     return subprocess.run(["launchctl", *args], capture_output=True, text=True, check=False)
 
