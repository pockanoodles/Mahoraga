+"""Record when the Mahoraga MCP server becomes visible to agents.
+
+This runs on the tool-discovery path (when `run_task` is listed in the
+agent's available tools). It writes a single fact — that the tool exists —
+so the funnel can distinguish "tool never started" from "tool there but unused".
+
+Design constraints:
+
+  1. **Never break tool discovery.** Any failure exits silently. A liveness
+     probe that can break tool discovery is worse than no liveness probe.
+  2. **Stdlib only.** No imports from the orchestrator (~20 ms versus ~500 ms
+     to load Typer).
+  3. **Fire-and-forget.** The log path and event name are defined here and in
+     `backend/orchestrator/routing/funnel_report.py`. If they drift, liveness
+     rows get written and silently never counted — the original failure mode.
+
+Install by adding to `~/.claude/settings.json` on the tool-discovery path:
+
+    "PostToolUse": [{
+      "matcher": "mcp__mahoraga__run_task",
+      "hooks": [{"type": "command", "async": true,
+                 "command": "python3 /path/to/Mahoraga/backend/mcp/funnel_liveness.py"}]
+    }]
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+LOG_PATH = Path.home() / ".mahoraga-v2" / "funnel.jsonl"
+ALIVE_EVENT = "mcp-alive"
+
+
+def record_alive(tools: int, log_path: Path | None = None) -> None:
+    """Record that the MCP server is alive.
+
+    Args:
+        tools: Number of tools available (for observability).
+        log_path: Optional path to override the default log file. If not
+            provided, uses LOG_PATH. Must be a writable directory or file.
+
+    This function never raises — even if the path doesn't exist or isn't
+    writable. A liveness probe that can break tool discovery is worse than
+    no liveness probe.
+    """
+    if log_path is None:
+        log_path = LOG_PATH
+
+    try:
+        # Check if we should be disabled
+        if os.getenv("MAHORAGA_FUNNEL_LIVENESS", "on").lower() == "off":
+            return
+
+        # Ensure parent directory exists
+        log_path.parent.mkdir(parents=True, exist_ok=True)
+
+        row = {
+            "ts": None,  # Will be set by caller or left as-is for batch writes
+            "session": "",  # Empty session to avoid inflating session count
+            "event": ALIVE_EVENT,
+            "tools": tools,
+        }
+
+        with log_path.open("a") as fh:
+            fh.write(json.dumps(row) + "\n")
+
+    except Exception:  # noqa: BLE001 — see constraint 1 in the module docstring
+        # Never raise — a liveness probe that can break tool discovery is worse
+        # than no liveness probe.
+        pass
