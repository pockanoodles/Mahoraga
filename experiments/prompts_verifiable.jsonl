# experiments/prompts_verifiable.jsonl — gold benchmark for execution-based
# (verifiable) rewards. Each row: {prompt, bucket, tier, entrypoint, verify,
# tests}. `tests` are Python asserts referencing `entrypoint`; the harness runs
# extract_code(model_output) + tests through python3 and passes iff exit 0.
# Ground truth self-validated by scratchpad/build_verifiable_bank.py: every
# test passes on a correct reference and fails on a broken one. verify=solution
# means 'produced code must pass hidden tests' (covers code + debug buckets).

{"prompt": "Write a Python function `reverse_string(s)` that returns the string `s` reversed.", "bucket": "code", "tier": "easy", "entrypoint": "reverse_string", "verify": "solution", "tests": "assert reverse_string('abc') == 'cba'\nassert reverse_string('') == ''\nassert reverse_string('a') == 'a'\nassert reverse_string('racecar') == 'racecar'"}
{"prompt": "Write a Python function `count_vowels(s)` that returns the number of vowels (a, e, i, o, u, case-insensitive) in the string `s`.", "bucket": "code", "tier": "easy", "entrypoint": "count_vowels", "verify": "solution", "tests": "assert count_vowels('hello') == 2\nassert count_vowels('AEIOU') == 5\nassert count_vowels('xyz') == 0\nassert count_vowels('') == 0"}
{"prompt": "Write a Python function `is_prime(n)` that returns True if the integer `n` is prime, else False. Numbers less than 2 are not prime.", "bucket": "code", "tier": "easy", "entrypoint": "is_prime", "verify": "solution", "tests": "assert is_prime(2) is True\nassert is_prime(3) is True\nassert is_prime(4) is False\nassert is_prime(1) is False\nassert is_prime(0) is False\nassert is_prime(17) is True\nassert is_prime(1_000_003) is True"}
{"prompt": "Write a Python function `fizzbuzz(n)` that returns a list of strings for 1..n inclusive: 'Fizz' if divisible by 3, 'Buzz' if divisible by 5, 'FizzBuzz' if divisible by both, otherwise the number as a string.", "bucket": "code", "tier": "easy", "entrypoint": "fizzbuzz", "verify": "solution", "tests": "assert fizzbuzz(5) == ['1', '2', 'Fizz', '4', 'Buzz']\nassert fizzbuzz(15)[-1] == 'FizzBuzz'\nassert fizzbuzz(3) == ['1', '2', 'Fizz']\nassert fizzbuzz(1) == ['1']"}
{"prompt": "Write a Python function `merge_sorted(a, b)` that merges two already-sorted lists `a` and `b` into a single sorted list and returns it.", "bucket": "code", "tier": "medium", "entrypoint": "merge_sorted", "verify": "solution", "tests": "assert merge_sorted([1,3,5], [2,4,6]) == [1,2,3,4,5,6]\nassert merge_sorted([], [1,2]) == [1,2]\nassert merge_sorted([1,2], []) == [1,2]\nassert merge_sorted([], []) == []\nassert merge_sorted([1,1], [1,1]) == [1,1,1,1]"}
{"prompt": "Write a Python function `flatten(lst)` that flattens a nested list of arbitrary depth into a single flat list, preserving left-to-right order. Only lists nest; other values are leaves.", "bucket": "code", "tier": "medium", "entrypoint": "flatten", "verify": "solution", "tests": "assert flatten([1, [2, [3, [4]]]]) == [1,2,3,4]\nassert flatten([]) == []\nassert flatten([1,2,3]) == [1,2,3]\nassert flatten([[1],[2],[3]]) == [1,2,3]\nassert flatten([1,[2,3],[4,[5,6]]]) == [1,2,3,4,5,6]"}
{"prompt": "Write a Python function `two_sum(nums, target)` that returns a tuple of the two indices (i, j) with i < j such that nums[i] + nums[j] == target. Assume exactly one solution exists.", "bucket": "code", "tier": "medium", "entrypoint": "two_sum", "verify": "solution", "tests": "assert two_sum([2,7,11,15], 9) == (0,1)\nassert two_sum([3,2,4], 6) == (1,2)\nassert two_sum([3,3], 6) == (0,1)\nassert two_sum([1,5,3,7], 8) in [(0,3),(1,2)]"}
{"prompt": "Write a Python function `valid_parentheses(s)` that returns True if the string `s` of brackets (){}[] is correctly matched and nested, else False.", "bucket": "code", "tier": "medium", "entrypoint": "valid_parentheses", "verify": "solution", "tests": "assert valid_parentheses('()') is True\nassert valid_parentheses('()[]{}') is True\nassert valid_parentheses('(]') is False\nassert valid_parentheses('([)]') is False\nassert valid_parentheses('{[]}') is True\nassert valid_parentheses('') is True\nassert valid_parentheses('(') is False"}
{"prompt": "Write a Python function `roman_to_int(s)` that converts a valid Roman numeral string `s` (I,V,X,L,C,D,M) to its integer value. Handle subtractive forms like IV=4 and IX=9.", "bucket": "code", "tier": "medium", "entrypoint": "roman_to_int", "verify": "solution", "tests": "assert roman_to_int('III') == 3\nassert roman_to_int('IV') == 4\nassert roman_to_int('IX') == 9\nassert roman_to_int('LVIII') == 58\nassert roman_to_int('MCMXCIV') == 1994"}
{"prompt": "Write a Python function `binary_search(arr, target)` that returns the index of `target` in the sorted list `arr`, or -1 if not present. Use binary search.", "bucket": "code", "tier": "medium", "entrypoint": "binary_search", "verify": "solution", "tests": "assert binary_search([1,2,3,4,5], 3) == 2\nassert binary_search([1,2,3,4,5], 1) == 0\nassert binary_search([1,2,3,4,5], 5) == 4\nassert binary_search([1,2,3,4,5], 6) == -1\nassert binary_search([], 1) == -1\nassert binary_search([2], 2) == 0"}
{"prompt": "Write a Python class `LRUCache` with `__init__(self, capacity)`, `get(self, key)` (returns the value or -1 if absent), and `put(self, key, value)`. When capacity is exceeded, evict the least-recently-used entry. Both get and put count as uses.", "bucket": "code", "tier": "hard", "entrypoint": "LRUCache", "verify": "solution", "tests": "c = LRUCache(2)\nc.put(1, 1)\nc.put(2, 2)\nassert c.get(1) == 1\nc.put(3, 3)  # evicts key 2\nassert c.get(2) == -1\nc.put(4, 4)  # evicts key 1\nassert c.get(1) == -1\nassert c.get(3) == 3\nassert c.get(4) == 4"}
{"prompt": "Write a Python function `longest_common_prefix(strs)` that returns the longest common prefix string among a list of strings `strs`, or '' if there is none.", "bucket": "code", "tier": "hard", "entrypoint": "longest_common_prefix", "verify": "solution", "tests": "assert longest_common_prefix(['flower','flow','flight']) == 'fl'\nassert longest_common_prefix(['dog','racecar','car']) == ''\nassert longest_common_prefix(['a']) == 'a'\nassert longest_common_prefix([]) == ''\nassert longest_common_prefix(['same','same']) == 'same'"}
{"prompt": "The function below should return the sum of all integers from 1 to n inclusive, but it has a bug. Return a corrected version of the function `sum_to_n(n)`.\n\ndef sum_to_n(n):\n    total = 0\n    for i in range(n):\n        total += i\n    return total", "bucket": "debug", "tier": "easy", "entrypoint": "sum_to_n", "verify": "solution", "tests": "assert sum_to_n(1) == 1\nassert sum_to_n(5) == 15\nassert sum_to_n(10) == 55\nassert sum_to_n(0) == 0"}
{"prompt": "The function below should append `item` to `lst` and return the list, defaulting to a fresh empty list. It has a classic bug where separate calls share state. Return a corrected version of `append_item(item, lst=None)`.\n\ndef append_item(item, lst=[]):\n    lst.append(item)\n    return lst", "bucket": "debug", "tier": "medium", "entrypoint": "append_item", "verify": "solution", "tests": "assert append_item(1) == [1]\nassert append_item(2) == [2]\nassert append_item(3, [0]) == [0, 3]\nassert append_item(9) == [9]"}
{"prompt": "The recursive factorial below has a wrong base case and returns incorrect results (and recurses forever for 0). Return a corrected version of `factorial(n)` for n >= 0.\n\ndef factorial(n):\n    return n * factorial(n - 1)", "bucket": "debug", "tier": "medium", "entrypoint": "factorial", "verify": "solution", "tests": "assert factorial(0) == 1\nassert factorial(1) == 1\nassert factorial(5) == 120\nassert factorial(6) == 720"}
{"prompt": "The function below computes the average of a list of numbers but crashes on an empty list. Return a corrected `average(nums)` that returns 0.0 for an empty list and the true mean otherwise.\n\ndef average(nums):\n    return sum(nums) / len(nums)", "bucket": "debug", "tier": "medium", "entrypoint": "average", "verify": "solution", "tests": "assert average([2,4,6]) == 4.0\nassert average([]) == 0.0\nassert average([5]) == 5.0\nassert average([1,2]) == 1.5"}
{"prompt": "The function below should return a dict mapping each distinct word in the string to its count, but it overwrites counts instead of accumulating. Return a corrected `word_count(text)` (split on whitespace).\n\ndef word_count(text):\n    counts = {}\n    for w in text.split():\n        counts[w] = 1\n    return counts", "bucket": "debug", "tier": "medium", "entrypoint": "word_count", "verify": "solution", "tests": "assert word_count('a b a') == {'a': 2, 'b': 1}\nassert word_count('') == {}\nassert word_count('x') == {'x': 1}\nassert word_count('the the the') == {'the': 3}"}
{"prompt": "The function below is meant to return the maximum sum of any contiguous non-empty subarray (Kadane's algorithm) but returns wrong results when all numbers are negative. Return a corrected `max_subarray(nums)`.\n\ndef max_subarray(nums):\n    best = 0\n    cur = 0\n    for n in nums:\n        cur = max(0, cur + n)\n        best = max(best, cur)\n    return best", "bucket": "debug", "tier": "hard", "entrypoint": "max_subarray", "verify": "solution", "tests": "assert max_subarray([-2,1,-3,4,-1,2,1,-5,4]) == 6\nassert max_subarray([1]) == 1\nassert max_subarray([-1,-2,-3]) == -1\nassert max_subarray([5,4,-1,7,8]) == 23"}
