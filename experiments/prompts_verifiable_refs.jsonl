{"entrypoint": "is_prime", "reference": "def is_prime(n):\n    if n < 2:\n        return False\n    if n < 4:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n", "mutant": "def is_prime(n):\n    if n < 2:\n        return False\n    # off-by-one: range excludes int(sqrt(n)) itself, so perfect\n    # squares like 4 and 9 are reported prime\n    for i in range(2, int(n ** 0.5)):\n        if n % i == 0:\n            return False\n    return True\n"}
{"entrypoint": "fizzbuzz", "reference": "def fizzbuzz(n):\n    out = []\n    for i in range(1, n + 1):\n        if i % 15 == 0:\n            out.append('FizzBuzz')\n        elif i % 3 == 0:\n            out.append('Fizz')\n        elif i % 5 == 0:\n            out.append('Buzz')\n        else:\n            out.append(str(i))\n    return out\n", "mutant": "def fizzbuzz(n):\n    out = []\n    # off-by-one: range(1, n) stops at n-1, dropping the last entry\n    for i in range(1, n):\n        if i % 15 == 0:\n            out.append('FizzBuzz')\n        elif i % 3 == 0:\n            out.append('Fizz')\n        elif i % 5 == 0:\n            out.append('Buzz')\n        else:\n            out.append(str(i))\n    return out\n"}
{"entrypoint": "merge_sorted", "reference": "def merge_sorted(a, b):\n    out = []\n    i = j = 0\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            out.append(a[i])\n            i += 1\n        else:\n            out.append(b[j])\n            j += 1\n    out.extend(a[i:])\n    out.extend(b[j:])\n    return out\n", "mutant": "def merge_sorted(a, b):\n    out = []\n    i = j = 0\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            out.append(a[i])\n            i += 1\n        else:\n            out.append(b[j])\n            j += 1\n    # forgets the leftovers of b after a is exhausted\n    out.extend(a[i:])\n    return out\n"}
{"entrypoint": "flatten", "reference": "def flatten(lst):\n    out = []\n    for item in lst:\n        if isinstance(item, list):\n            out.extend(flatten(item))\n        else:\n            out.append(item)\n    return out\n", "mutant": "def flatten(lst):\n    # only flattens one level instead of recursing to arbitrary depth\n    out = []\n    for item in lst:\n        if isinstance(item, list):\n            out.extend(item)\n        else:\n            out.append(item)\n    return out\n"}
{"entrypoint": "two_sum", "reference": "def two_sum(nums, target):\n    seen = {}\n    for j, n in enumerate(nums):\n        need = target - n\n        if need in seen:\n            return (seen[need], j)\n        seen[n] = j\n    return None\n", "mutant": "def two_sum(nums, target):\n    # inner range starts at i instead of i + 1, so an element can be\n    # paired with itself\n    for i in range(len(nums)):\n        for j in range(i, len(nums)):\n            if nums[i] + nums[j] == target:\n                return (i, j)\n    return None\n"}
{"entrypoint": "valid_parentheses", "reference": "def valid_parentheses(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    stack = []\n    for c in s:\n        if c in '([{':\n            stack.append(c)\n        elif c in pairs:\n            if not stack or stack.pop() != pairs[c]:\n                return False\n    return not stack\n", "mutant": "def valid_parentheses(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    stack = []\n    for c in s:\n        if c in '([{':\n            stack.append(c)\n        elif c in pairs:\n            if not stack or stack.pop() != pairs[c]:\n                return False\n    # forgets to check for unclosed openers left on the stack\n    return True\n"}
{"entrypoint": "roman_to_int", "reference": "def roman_to_int(s):\n    values = {'I': 1, 'V': 5, 'X': 10, 'L': 50,\n              'C': 100, 'D': 500, 'M': 1000}\n    total = 0\n    for i, c in enumerate(s):\n        v = values[c]\n        if i + 1 < len(s) and v < values[s[i + 1]]:\n            total -= v\n        else:\n            total += v\n    return total\n", "mutant": "def roman_to_int(s):\n    # ignores subtractive forms: IV comes out as 6, not 4\n    values = {'I': 1, 'V': 5, 'X': 10, 'L': 50,\n              'C': 100, 'D': 500, 'M': 1000}\n    return sum(values[c] for c in s)\n"}
{"entrypoint": "binary_search", "reference": "def binary_search(arr, target):\n    lo, hi = 0, len(arr) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == target:\n            return mid\n        if arr[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1\n", "mutant": "def binary_search(arr, target):\n    # off-by-one: `lo < hi` never inspects the final candidate, so\n    # single-element arrays and last-slot hits are missed\n    lo, hi = 0, len(arr) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == target:\n            return mid\n        if arr[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1\n"}
{"entrypoint": "LRUCache", "reference": "from collections import OrderedDict\n\nclass LRUCache:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.data = OrderedDict()\n\n    def get(self, key):\n        if key not in self.data:\n            return -1\n        self.data.move_to_end(key)\n        return self.data[key]\n\n    def put(self, key, value):\n        if key in self.data:\n            self.data.move_to_end(key)\n        self.data[key] = value\n        if len(self.data) > self.capacity:\n            self.data.popitem(last=False)\n", "mutant": "from collections import OrderedDict\n\nclass LRUCache:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.data = OrderedDict()\n\n    def get(self, key):\n        # bug: get does not refresh recency, so reads never count\n        # as uses and the wrong entry gets evicted\n        if key not in self.data:\n            return -1\n        return self.data[key]\n\n    def put(self, key, value):\n        if key in self.data:\n            self.data.move_to_end(key)\n        self.data[key] = value\n        if len(self.data) > self.capacity:\n            self.data.popitem(last=False)\n"}
{"entrypoint": "longest_common_prefix", "reference": "def longest_common_prefix(strs):\n    if not strs:\n        return ''\n    prefix = strs[0]\n    for s in strs[1:]:\n        while not s.startswith(prefix):\n            prefix = prefix[:-1]\n            if not prefix:\n                return ''\n    return prefix\n", "mutant": "def longest_common_prefix(strs):\n    # missed edge case: crashes with IndexError on an empty list\n    prefix = strs[0]\n    for s in strs[1:]:\n        while not s.startswith(prefix):\n            prefix = prefix[:-1]\n            if not prefix:\n                return ''\n    return prefix\n"}
