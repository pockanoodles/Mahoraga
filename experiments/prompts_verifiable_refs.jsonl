{"entrypoint": "max_subarray", "reference": "def max_subarray(nums):\n    best = nums[0]\n    cur = nums[0]\n    for n in nums[1:]:\n        cur = max(n, cur + n)\n        best = max(best, cur)\n    return best\n", "mutant": "def max_subarray(nums):\n    best = 0\n    cur = 0\n    for n in nums:\n        cur = max(0, cur + n)\n        best = max(best, cur)\n    return best\n"}
{"entrypoint": "rle_encode", "reference": "def rle_encode(s):\n    if not s:\n        return ''\n    out = []\n    prev = s[0]\n    count = 1\n    for c in s[1:]:\n        if c == prev:\n            count += 1\n        else:\n            out.append(prev + str(count))\n            prev, count = c, 1\n    out.append(prev + str(count))\n    return ''.join(out)", "mutant": "def rle_encode(s):\n    if not s:\n        return ''\n    out = []\n    prev = s[0]\n    count = 1\n    for c in s[1:]:\n        if c == prev:\n            count += 1\n        else:\n            out.append(prev + (str(count) if count > 1 else ''))\n            prev, count = c, 1\n    out.append(prev + (str(count) if count > 1 else ''))\n    return ''.join(out)"}
{"entrypoint": "parse_duration", "reference": "import re\n\ndef parse_duration(s):\n    m = re.fullmatch(r'(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?', s)\n    h, mi, se = (int(g) if g else 0 for g in m.groups())\n    return h * 3600 + mi * 60 + se", "mutant": "import re\n\ndef parse_duration(s):\n    m = re.fullmatch(r'(\\d+)h(\\d+)m(\\d+)s', s)\n    h, mi, se = (int(g) for g in m.groups())\n    return h * 3600 + mi * 60 + se"}
{"entrypoint": "dedupe_keep_last", "reference": "def dedupe_keep_last(items):\n    seen = set()\n    out = []\n    for x in reversed(items):\n        if x not in seen:\n            seen.add(x)\n            out.append(x)\n    out.reverse()\n    return out", "mutant": "def dedupe_keep_last(items):\n    seen = set()\n    out = []\n    for x in items:\n        if x not in seen:\n            seen.add(x)\n            out.append(x)\n    return out"}
{"entrypoint": "chunk_list", "reference": "def chunk_list(lst, n):\n    if n <= 0:\n        raise ValueError('n must be positive')\n    return [lst[i:i + n] for i in range(0, len(lst), n)]", "mutant": "def chunk_list(lst, n):\n    if n <= 0:\n        raise ValueError('n must be positive')\n    return [lst[i:i + n] for i in range(0, len(lst) - n + 1, n)]"}
{"entrypoint": "caesar", "reference": "def caesar(s, k):\n    k %= 26\n    out = []\n    for c in s:\n        if 'a' <= c <= 'z':\n            out.append(chr((ord(c) - 97 + k) % 26 + 97))\n        elif 'A' <= c <= 'Z':\n            out.append(chr((ord(c) - 65 + k) % 26 + 65))\n        else:\n            out.append(c)\n    return ''.join(out)", "mutant": "def caesar(s, k):\n    out = []\n    for c in s:\n        if c.isalpha():\n            out.append(chr(ord(c) + k))\n        else:\n            out.append(c)\n    return ''.join(out)"}
{"entrypoint": "int_to_roman", "reference": "def int_to_roman(n):\n    pairs = [(1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n             (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n             (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')]\n    out = []\n    for value, sym in pairs:\n        while n >= value:\n            out.append(sym)\n            n -= value\n    return ''.join(out)", "mutant": "def int_to_roman(n):\n    pairs = [(1000, 'M'), (500, 'D'), (100, 'C'), (50, 'L'),\n             (10, 'X'), (5, 'V'), (1, 'I')]\n    out = []\n    for value, sym in pairs:\n        while n >= value:\n            out.append(sym)\n            n -= value\n    return ''.join(out)"}
{"entrypoint": "merge_intervals", "reference": "def merge_intervals(intervals):\n    ivs = sorted([list(iv) for iv in intervals])\n    out = []\n    for s, e in ivs:\n        if out and s <= out[-1][1]:\n            out[-1][1] = max(out[-1][1], e)\n        else:\n            out.append([s, e])\n    return out", "mutant": "def merge_intervals(intervals):\n    ivs = sorted([list(iv) for iv in intervals])\n    out = []\n    for s, e in ivs:\n        if out and s < out[-1][1]:\n            out[-1][1] = max(out[-1][1], e)\n        else:\n            out.append([s, e])\n    return out"}
{"entrypoint": "sliding_max", "reference": "from collections import deque\n\ndef sliding_max(nums, k):\n    dq = deque()\n    out = []\n    for i, x in enumerate(nums):\n        while dq and nums[dq[-1]] <= x:\n            dq.pop()\n        dq.append(i)\n        if dq[0] <= i - k:\n            dq.popleft()\n        if i >= k - 1:\n            out.append(nums[dq[0]])\n    return out", "mutant": "def sliding_max(nums, k):\n    return [max(nums[i:i + k]) for i in range(len(nums) - k)]"}
{"entrypoint": "edit_distance", "reference": "def edit_distance(a, b):\n    prev = list(range(len(b) + 1))\n    for i, ca in enumerate(a, 1):\n        cur = [i]\n        for j, cb in enumerate(b, 1):\n            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))\n        prev = cur\n    return prev[-1]", "mutant": "def edit_distance(a, b):\n    prev = list(range(len(b) + 1))\n    for i, ca in enumerate(a, 1):\n        cur = [i]\n        for j, cb in enumerate(b, 1):\n            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (0 if ca == cb else 2)))\n        prev = cur\n    return prev[-1]"}
{"entrypoint": "topo_sort", "reference": "import heapq\n\ndef topo_sort(n, edges):\n    adj = [[] for _ in range(n)]\n    indeg = [0] * n\n    for u, v in edges:\n        adj[u].append(v)\n        indeg[v] += 1\n    heap = [i for i in range(n) if indeg[i] == 0]\n    heapq.heapify(heap)\n    out = []\n    while heap:\n        u = heapq.heappop(heap)\n        out.append(u)\n        for v in adj[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                heapq.heappush(heap, v)\n    return out if len(out) == n else []", "mutant": "from collections import deque\n\ndef topo_sort(n, edges):\n    adj = [[] for _ in range(n)]\n    indeg = [0] * n\n    for u, v in edges:\n        adj[u].append(v)\n        indeg[v] += 1\n    queue = deque(i for i in range(n) if indeg[i] == 0)\n    out = []\n    while queue:\n        u = queue.popleft()\n        out.append(u)\n        for v in adj[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                queue.append(v)\n    return out if len(out) == n else []"}
{"entrypoint": "spiral_order", "reference": "def spiral_order(matrix):\n    if not matrix:\n        return []\n    out = []\n    top, bottom = 0, len(matrix) - 1\n    left, right = 0, len(matrix[0]) - 1\n    while top <= bottom and left <= right:\n        for c in range(left, right + 1):\n            out.append(matrix[top][c])\n        top += 1\n        for r in range(top, bottom + 1):\n            out.append(matrix[r][right])\n        right -= 1\n        if top <= bottom:\n            for c in range(right, left - 1, -1):\n                out.append(matrix[bottom][c])\n            bottom -= 1\n        if left <= right:\n            for r in range(bottom, top - 1, -1):\n                out.append(matrix[r][left])\n            left += 1\n    return out", "mutant": "def spiral_order(matrix):\n    if not matrix:\n        return []\n    out = []\n    top, bottom = 0, len(matrix) - 1\n    left, right = 0, len(matrix[0]) - 1\n    while top <= bottom and left <= right:\n        for c in range(left, right + 1):\n            out.append(matrix[top][c])\n        top += 1\n        for r in range(top, bottom + 1):\n            out.append(matrix[r][right])\n        right -= 1\n        for c in range(right, left - 1, -1):\n            out.append(matrix[bottom][c])\n        bottom -= 1\n        for r in range(bottom, top - 1, -1):\n            out.append(matrix[r][left])\n        left += 1\n    return out"}
{"entrypoint": "csv_split", "reference": "def csv_split(line):\n    fields = []\n    cur = []\n    in_quotes = False\n    i = 0\n    while i < len(line):\n        c = line[i]\n        if in_quotes:\n            if c == '\"':\n                if i + 1 < len(line) and line[i + 1] == '\"':\n                    cur.append('\"')\n                    i += 1\n                else:\n                    in_quotes = False\n            else:\n                cur.append(c)\n        else:\n            if c == '\"':\n                in_quotes = True\n            elif c == ',':\n                fields.append(''.join(cur))\n                cur = []\n            else:\n                cur.append(c)\n        i += 1\n    fields.append(''.join(cur))\n    return fields", "mutant": "def csv_split(line):\n    fields = []\n    cur = []\n    in_quotes = False\n    for c in line:\n        if c == '\"':\n            in_quotes = not in_quotes\n        elif c == ',' and not in_quotes:\n            fields.append(''.join(cur))\n            cur = []\n        else:\n            cur.append(c)\n    fields.append(''.join(cur))\n    return fields"}
{"entrypoint": "semver_cmp", "reference": "def semver_cmp(a, b):\n    def parse(v):\n        if '-' in v:\n            main, pre = v.split('-', 1)\n        else:\n            main, pre = v, None\n        return [int(x) for x in main.split('.')], pre\n\n    ma, pa = parse(a)\n    mb, pb = parse(b)\n    n = max(len(ma), len(mb))\n    ma += [0] * (n - len(ma))\n    mb += [0] * (n - len(mb))\n    if ma != mb:\n        return -1 if ma < mb else 1\n    if pa == pb:\n        return 0\n    if pa is None:\n        return 1\n    if pb is None:\n        return -1\n    return -1 if pa < pb else 1", "mutant": "def semver_cmp(a, b):\n    def parse(v):\n        if '-' in v:\n            main, pre = v.split('-', 1)\n        else:\n            main, pre = v, None\n        return main.split('.'), pre\n\n    ma, pa = parse(a)\n    mb, pb = parse(b)\n    n = max(len(ma), len(mb))\n    ma += ['0'] * (n - len(ma))\n    mb += ['0'] * (n - len(mb))\n    if ma != mb:\n        return -1 if ma < mb else 1\n    if pa == pb:\n        return 0\n    if pa is None:\n        return 1\n    if pb is None:\n        return -1\n    return -1 if pa < pb else 1"}
{"entrypoint": "json_pointer", "reference": "def json_pointer(obj, pointer):\n    if pointer == '':\n        return obj\n    cur = obj\n    for token in pointer.split('/')[1:]:\n        token = token.replace('~1', '/').replace('~0', '~')\n        if isinstance(cur, list):\n            try:\n                idx = int(token)\n            except ValueError:\n                raise KeyError(token)\n            if not 0 <= idx < len(cur):\n                raise KeyError(token)\n            cur = cur[idx]\n        elif isinstance(cur, dict):\n            if token not in cur:\n                raise KeyError(token)\n            cur = cur[token]\n        else:\n            raise KeyError(token)\n    return cur", "mutant": "def json_pointer(obj, pointer):\n    if pointer == '':\n        return obj\n    cur = obj\n    for token in pointer.split('/')[1:]:\n        if isinstance(cur, list):\n            try:\n                idx = int(token)\n            except ValueError:\n                raise KeyError(token)\n            if not 0 <= idx < len(cur):\n                raise KeyError(token)\n            cur = cur[idx]\n        elif isinstance(cur, dict):\n            if token not in cur:\n                raise KeyError(token)\n            cur = cur[token]\n        else:\n            raise KeyError(token)\n    return cur"}
{"entrypoint": "longest_pal_substr", "reference": "def longest_pal_substr(s):\n    if not s:\n        return ''\n    best_start, best_len = 0, 1\n    for center in range(len(s)):\n        for lo, hi in ((center, center), (center, center + 1)):\n            while lo >= 0 and hi < len(s) and s[lo] == s[hi]:\n                lo -= 1\n                hi += 1\n            length = hi - lo - 1\n            if length > best_len:\n                best_len = length\n                best_start = lo + 1\n    return s[best_start:best_start + best_len]", "mutant": "def longest_pal_substr(s):\n    if not s:\n        return ''\n    best_start, best_len = 0, 1\n    for center in range(len(s)):\n        for lo, hi in ((center, center), (center, center + 1)):\n            while lo >= 0 and hi < len(s) and s[lo] == s[hi]:\n                lo -= 1\n                hi += 1\n            length = hi - lo - 1\n            if length >= best_len:\n                best_len = length\n                best_start = lo + 1\n    return s[best_start:best_start + best_len]"}
{"entrypoint": "group_anagrams", "reference": "def group_anagrams(words):\n    groups = {}\n    for w in words:\n        groups.setdefault(''.join(sorted(w)), []).append(w)\n    result = [sorted(g) for g in groups.values()]\n    result.sort(key=lambda g: g[0])\n    return result", "mutant": "def group_anagrams(words):\n    groups = {}\n    for w in words:\n        groups.setdefault(''.join(sorted(w)), []).append(w)\n    result = list(groups.values())\n    result.sort(key=lambda g: g[0])\n    return result"}
{"entrypoint": "wildcard_match", "reference": "def wildcard_match(s, p):\n    m, n = len(s), len(p)\n    dp = [[False] * (n + 1) for _ in range(m + 1)]\n    dp[0][0] = True\n    for j in range(1, n + 1):\n        if p[j - 1] == '*':\n            dp[0][j] = dp[0][j - 1]\n    for i in range(1, m + 1):\n        for j in range(1, n + 1):\n            if p[j - 1] == '*':\n                dp[i][j] = dp[i][j - 1] or dp[i - 1][j]\n            elif p[j - 1] == '?' or p[j - 1] == s[i - 1]:\n                dp[i][j] = dp[i - 1][j - 1]\n    return dp[m][n]", "mutant": "def wildcard_match(s, p):\n    m, n = len(s), len(p)\n    dp = [[False] * (n + 1) for _ in range(m + 1)]\n    dp[0][0] = True\n    for i in range(1, m + 1):\n        for j in range(1, n + 1):\n            if p[j - 1] == '*':\n                dp[i][j] = dp[i - 1][j - 1] or dp[i - 1][j]\n            elif p[j - 1] == '?' or p[j - 1] == s[i - 1]:\n                dp[i][j] = dp[i - 1][j - 1]\n    return dp[m][n]"}
{"entrypoint": "to_base", "reference": "def to_base(n, b):\n    if b < 2 or b > 16:\n        raise ValueError('base out of range')\n    if n == 0:\n        return '0'\n    digits = '0123456789abcdef'\n    neg = n < 0\n    n = abs(n)\n    out = []\n    while n:\n        out.append(digits[n % b])\n        n //= b\n    if neg:\n        out.append('-')\n    return ''.join(reversed(out))", "mutant": "def to_base(n, b):\n    if b < 2 or b > 16:\n        raise ValueError('base out of range')\n    digits = '0123456789abcdef'\n    neg = n < 0\n    n = abs(n)\n    out = []\n    while n:\n        out.append(digits[n % b])\n        n //= b\n    if neg:\n        out.append('-')\n    return ''.join(reversed(out))"}
