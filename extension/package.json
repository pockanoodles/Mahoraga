{
  "name": "ollama-runtime",
  "displayName": "Ollama Runtime",
  "description": "Local coding agent powered by Ollama",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ollama-runtime",
          "title": "Ollama Runtime",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ollama-runtime": [
        {
          "type": "webview",
          "id": "ollama-runtime.panel",
          "name": "Agent"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "highlight.js": "^11.9.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.3.0"
  }
}
