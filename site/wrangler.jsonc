{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The landing page for kaitosoeno.com/mahoraga. An assets-only Worker on
  // that route: the personal site stays the origin for every other path, and
  // this one ships on Mahoraga's own release schedule.
  "name": "kaitosoeno-mahoraga",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "kaitosoeno.com/mahoraga*", "zone_name": "kaitosoeno.com" }]
}
